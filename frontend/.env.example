# TradeTix / SafeTicket frontend — copy to .env.local for local development.
# Vite bakes these into the production bundle at build time (set in Render dashboard for deploys).

# Public Django API origin (include host only or full URL; /api suffix is added automatically if missing).
# Local dev with Vite proxy: optional — defaults to http://localhost:8000/api when unset in dev.
# Production: REQUIRED — e.g. https://safeticket-api.onrender.com
VITE_API_URL=http://localhost:8000

# When "true", checkout uses Payme hosted payment instead of the mock card form.
# Must match backend PayMe configuration (PAYME_* env vars on the API service).
# PayMe SANDBOX dashboard login (NOT production): tradetix.support+1@gmail.com
# Backend PAYME_SANDBOX_ACCOUNT_EMAIL must match when PAYME_API_URL=testpay.payme.io
# VITE_USE_PAYME=false

# DEV ONLY — shared secret for mock payment confirm in local/staging builds.
# NEVER set this in production static-site or API builds; it would be exposed in the client bundle.
# VITE_MOCK_PAYMENT_WEBHOOK_SECRET=

# Optional: PostHog analytics (see main.jsx)
# VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=
# VITE_PUBLIC_POSTHOG_HOST=

# Optional: build stamp shown on Sell page (Render sets RENDER_GIT_COMMIT during CI)
# VITE_BUILD_ID=local-dev

# SafeTrade Backend - Environment Variables
# Copy this file to .env and fill in production values.
# NEVER commit .env to version control.

# Required for production - generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-production-secret-key-here

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hosts (e.g. for production: yourdomain.com,api.yourdomain.com)
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: Database (uncomment in settings.py when using PostgreSQL)
# DB_NAME=safeticket
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Payme.io (sandbox / test — never commit real keys)
# Sandbox dashboard login (NOT production): tradetix.support+1@gmail.com
# Use this account only for test/preprod PayMe — keeps sandbox separate from live PayMe.
PAYME_SANDBOX_ACCOUNT_EMAIL=tradetix.support+1@gmail.com

# --- Option A: PayMe preprod / staging (recommended for your MPL test key) ---
# PAYME_SELLER_ID=MPL17808-XXXXXXXX-XXXXXXXX-XXXXXXXX
# PAYME_GENERATE_SALE_URL=https://preprod.paymeservice.com/api/generate-sale
# PAYME_API_URL=https://preprod.paymeservice.com/api

# --- Option B: legacy testpay host (defaults if unset) ---
# Standard sale flow: PAYME_SELLER_ID = your MPL merchant id from PayMe dashboard.
# PAYME_API_URL defaults to https://testpay.payme.io/api
# PAYME_GENERATE_SALE_URL defaults to {PAYME_API_URL}/generate-sale

# Standard Seller accounts do not receive merchant_password. Webhooks are verified
# by calling get-sales (primary) / get-transactions (fallback) with seller_payme_id
# only — never send the MPL id as payme_client_key (that returns "service not found").
# Use the LIVE host for production sales:
#   PAYME_API_URL=https://live.payme.io/api
#   PAYME_GENERATE_SALE_URL=https://live.payme.io/api/generate-sale
PAYME_SELLER_ID=
PAYME_API_URL=https://live.payme.io/api
PAYME_GENERATE_SALE_URL=https://live.payme.io/api/generate-sale
PAYME_MERCHANT_ID=
PAYME_API_KEY=
PAYME_API_PASSWORD=
PAYME_API_SECRET=
PAYME_WEBHOOK_SECRET=

PAYME_SUB_SELLER_PAYEE_ID=
# PAYME_EXTRA_BODY_JSON={}

# Frontend (Vite): set VITE_USE_PAYME=true to use Payme hosted checkout instead of mock card form.
# VITE_USE_PAYME=true

# Optional: Email. Receipts prefer Resend when RESEND_API_KEY is set; otherwise Django SMTP.
# RESEND_API_KEY=re_xxxxxxxx
# DEFAULT_FROM_EMAIL=TradeTix <tickets@tradetix.co.il>
#
# Gmail SMTP (must use a 16-character App Password, not your normal Gmail password):
#   Google Account → Security → 2-Step Verification → App passwords
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=your-gmail@gmail.com
# EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
# EMAIL_TIMEOUT=20

# Google Analytics Data API (last-7-days overview).
# Numeric Property ID from Analytics Admin → Property settings (not G-XXXXXXXX).
# Auth: gcloud auth application-default login --scopes=https://www.googleapis.com/auth/cloud-platform,https://www.googleapis.com/auth/analytics.readonly
# GA4_PROPERTY_ID=
